# Email configuration (prod)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=prod@example.com
EMAIL_PASS=replace_me
EMAIL_FROM=Puppy Ping <prod@example.com>
EMAILS_TO=alerts@example.com

# Postgres (prod docker-compose)
PGHOST=postgres
PGPORT=5432
PGUSER=puppyping
PGPASSWORD=replace_me
PGDATABASE=puppyping

# pgAdmin (prod)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_me

# PupSwipe prod host mapping (keep bound to localhost when using compose.tunnel.yml)
PUPSWIPE_BIND_IP=127.0.0.1
PUPSWIPE_PORT=8010
# Public base URL used in forgot-password reset emails
PUPSWIPE_PUBLIC_URL=https://puppyping.com
# PupSwipe cookie signing secret (set a long random value)
PUPSWIPE_SESSION_SECRET=replace_me_with_long_random_secret
# PupSwipe feed sources (comma-separated)
PUPSWIPE_SOURCES=paws_chicago,wright_way

# Optional production container image & Postgres backup overrides
# PUPPYPING_IMAGE=ghcr.io/badbayesian/puppy_ping:main
# POSTGRES_BACKUP_DIR=/mnt/thebutler/config/puppy_ping/postgres/backups
# POSTGRES_BACKUP_RETENTION_DAYS=30

